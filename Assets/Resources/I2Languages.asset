      Languages:
      - Crit +3%
      - "Ch\xED m\u1EA1ng +3%"
      Flags: 0000
      Languages_Touch: []
    - Term: Fortune/Heal
      TermType: 0
      Description: 
      Languages:
      - Heal 20% HP
      - "H\u1ED3i 20% HP"
      Flags: 0000
