      Languages:
      - Frost Serpent
      - "B\u0103ng X\xE0"
      Flags: 0000
      Languages_Touch: []
    - Term: Narrative/BeastName/7
      TermType: 0
      Description: 
      Languages:
      - Woodwraith
      - "M\u1ED9c Linh"
      Flags: 0000
      Languages_Touch: []
    - Term: Narrative/BeastName/8
      TermType: 0
      Description: 
      Languages:
      - Bloodwing
      - "Huy\u1EBFt B\u1EE9c"
      Flags: 0000
      Languages_Touch: []
    - Term: Narrative/BossName/1
      TermType: 0
      Description: 
      Languages:
      - Mountain Lord
      - "S\u01A1n Qu\xE2n"
      Flags: 0000
      Languages_Touch: []
    - Term: Narrative/BossName/2
