    - Term: Sidekick/Gloop/Desc
      TermType: 0
      Description: 
      Languages:
      - adds +15% of your ATK each strike
      - "c\u1ED9ng th\xEAm 15% ATK m\u1ED7i \u0111\xF2n \u0111\xE1nh"
      Flags: 0000
      Languages_Touch: []
    - Term: Sidekick/Sporeling/Name
      TermType: 0
      Description: 
      Languages:
      - Sporeling
      - Sporeling
      Flags: 0000
