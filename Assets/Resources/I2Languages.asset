      - "t\u1EC9 l\u1EC7 ch\xED m\u1EA1ng +6%"
      Flags: 0000
      Languages_Touch: []
    - Term: Fortune/MaxHp
      TermType: 0
      Description: 
      Languages:
      - Max HP +7%
      - "HP t\u1ED1i \u0111a +7%"
      Flags: 0000
      Languages_Touch: []
    - Term: Fortune/Atk
      TermType: 0
      Description: 
      Languages:
      - ATK +5%
      - ATK +5%
      Flags: 0000
      Languages_Touch: []
