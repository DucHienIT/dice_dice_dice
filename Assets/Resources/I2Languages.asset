      - "K\u1EBB Nu\u1ED1t Ch\u1EEDng"
      Flags: 0000
      Languages_Touch: []
    - Term: Narrative/BossName/4
      TermType: 0
      Description: 
      Languages:
      - Empress Vex
      - "N\u1EEF Ho\xE0ng Vex"
      Flags: 0000
      Languages_Touch: []
    - Term: Narrative/BossName/5
      TermType: 0
      Description: 
      Languages:
      - Null Titan
      - "Titan H\u01B0 V\xF4"
      Flags: 0000
