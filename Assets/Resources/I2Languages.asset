      Languages:
      - Flame Qilin
      - "H\u1ECFa K\u1EF3 L\xE2n"
      Flags: 0000
      Languages_Touch: []
    - Term: Narrative/BossName/3
      TermType: 0
      Description: 
      Languages:
      - Frost Dragon
      - "B\u0103ng Giao Long"
      Flags: 0000
      Languages_Touch: []
    - Term: Narrative/BossName/4
      TermType: 0
      Description: 
      Languages:
      - Gloom Demon Lord
      - "U Minh Ma Qu\xE2n"
      Flags: 0000
      Languages_Touch: []
    - Term: Narrative/BossName/5
      TermType: 0
      Description: 
      Languages:
      - Hollow Ancient God
      - "H\u01B0 Kh\xF4ng C\u1ED5 Th\u1EA7n"
      Flags: 0000
      Languages_Touch: []
    - Term: World/AzureCloud
      TermType: 0
      Description: 
      Languages:
      - Azure Cloud Peaks
      - "Thanh V\xE2n S\u01A1n"
      Flags: 0000
      Languages_Touch: []
    - Term: World/Emberfall
      TermType: 0
      Description: 
      Languages:
      - Emberfall Valley
      - "H\u1ECFa Di\u1EC7m C\u1ED1c"
      Flags: 0000
      Languages_Touch: []
    - Term: World/Frostmoon
      TermType: 0
      Description: 
      Languages:
      - Frostmoon Ridge
      - "H\xE0n Nguy\u1EC7t Phong"
      Flags: 0000
      Languages_Touch: []
    - Term: World/Gloomfen
      TermType: 0
      Description: 
      Languages:
      - Gloomfen Marsh
      - "U Minh Tr\u1EA1ch"
      Flags: 0000
      Languages_Touch: []
    - Term: World/HollowDeep
      TermType: 0
      Description: 
      Languages:
      - The Hollow Deep
      - "H\u01B0 Kh\xF4ng Uy\xEAn"
      Flags: 0000
      Languages_Touch: []
    - Term: Sidekick/FlyingSword/Name
      TermType: 0
      Description: 
      Languages:
      - Flying Sword
      - "Phi Ki\u1EBFm"
      Flags: 0000
      Languages_Touch: []
    - Term: Sidekick/FlyingSword/Desc
      TermType: 0
      Description: 
      Languages:
      - adds +15% of your ATK each strike
      - "c\u1ED9ng th\xEAm 15% ATK m\u1ED7i \u0111\xF2n \u0111\xE1nh"
      Flags: 0000
      Languages_Touch: []
    - Term: Sidekick/Lingzhi/Name
      TermType: 0
      Description: 
      Languages:
      - Lingzhi Sprite
      - Linh Chi
      Flags: 0000
      Languages_Touch: []
    - Term: Sidekick/Lingzhi/Desc
      TermType: 0
      Description: 
      Languages:
      - heals 2% Max HP each beat
      - "h\u1ED3i 2% HP t\u1ED1i \u0111a m\u1ED7i nh\u1ECBp"
      Flags: 0000
      Languages_Touch: []
    - Term: Sidekick/ShellWard/Name
      TermType: 0
      Description: 
      Languages:
      - Shell Ward
      - "Quy Gi\xE1p"
      Flags: 0000
      Languages_Touch: []
    - Term: Sidekick/ShellWard/Desc
      TermType: 0
      Description: 
      Languages:
      - blocks 12% incoming damage
      - "ch\u1EB7n 12% s\xE1t th\u01B0\u01A1ng nh\u1EADn v\xE0o"
      Flags: 0000
      Languages_Touch: []
    - Term: Sidekick/ThunderPearl/Name
      TermType: 0
      Description: 
      Languages:
      - Thunder Pearl
      - "L\xF4i Ch\xE2u"
      Flags: 0000
      Languages_Touch: []
    - Term: Sidekick/ThunderPearl/Desc
      TermType: 0
      Description: 
      Languages:
      - crit chance +6%
      - "t\u1EC9 l\u1EC7 ch\xED m\u1EA1ng +6%"
      Flags: 0000
      Languages_Touch: []
    - Term: Fortune/MaxHp
      TermType: 0
      Description: 
      Languages:
      - Max HP +7%
      - "HP t\u1ED1i \u0111a +7%"
      Flags: 0000
      Languages_Touch: []
    - Term: Fortune/Atk
      TermType: 0
      Description: 
      Languages:
      - ATK +5%
      - ATK +5%
      Flags: 0000
      Languages_Touch: []
    - Term: Fortune/Def
